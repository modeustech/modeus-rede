RewriteEngine On

# Enforce HTTPS when behind proxy/load balancer.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Canonical host without www.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect legacy English URLs to clean routes.
Redirect 301 /index.html /
Redirect 301 /about.html /about
Redirect 301 /brand.html /brand
Redirect 301 /careers.html /careers
Redirect 301 /services.html /services
Redirect 301 /configurator.html /configurator
Redirect 301 /get-in-touch.html /get-in-touch
Redirect 301 /privacy.html /privacy
Redirect 301 /terms.html /terms
Redirect 301 /dealers-retailers.html /dealers-retailers
Redirect 301 /interior-professionals.html /interior-professionals
Redirect 301 /private-label-oem.html /private-label-oem

# Redirect legacy Dutch URLs to /nl routes.
Redirect 301 /index-nl.html /nl
Redirect 301 /about-nl.html /nl/about
Redirect 301 /brand-nl.html /nl/brand
Redirect 301 /careers-nl.html /nl/careers
Redirect 301 /services-nl.html /nl/services
Redirect 301 /configurator-nl.html /nl/configurator
Redirect 301 /get-in-touch-nl.html /nl/get-in-touch
Redirect 301 /privacy-nl.html /nl/privacy
Redirect 301 /terms-nl.html /nl/terms

# Canonicalize trailing slashes (except root and /nl root).
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} !^/nl/?$
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+)/$ /$1 [R=301,L]
